# Copy to .env (git-ignored) and set real values. Read by backend/database.py,
# backend/logic/auth.py, alembic and the Steward bridge.

# --- PostgreSQL (the platform connects as the schema owner) -------------------------
POSTGRES_USER=prayog
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=prayog

# --- Authentication ------------------------------------------------------------------
JWT_SECRET_KEY=generate-a-long-random-secret

# --- Steward (steward/docs/INTEGRATION.md) -------------------------------------------
# Its own role, created by `python -m scripts.setup_steward`: NOSUPERUSER NOBYPASSRLS,
# so row-level security on users' diagnostic data holds.
STEWARD_DB_USER=steward_app
STEWARD_DB_PASSWORD=change-me-too
STEWARD_RUNTIME_URL=http://127.0.0.1:8100
STEWARD_PUBLIC_BASE_URL=http://127.0.0.1:8000     # where Steward links point
STEWARD_ENABLED=true                               # false: the platform runs without it
# STEWARD_INPROCESS_REASONING=heuristic            # dev: no separate Runtime process
# STEWARD_COOKIE_SECURE=true                       # behind a TLS-terminating proxy
# STEWARD_SEARCH_PROVIDER=none                     # none | tavily | brave (+ STEWARD_SEARCH_API_KEY)

# --- Steward Runtime (its own process) -----------------------------------------------
STEWARD_REASONING=heuristic                        # claude | heuristic | stub
STEWARD_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- Scheduler overrides (backend/logic/scheduler/config.py), e.g. -------------------
# PRAYOG_SCHED_MAX_WALLTIME_MINUTES=2880
