# Copy to .env for local runs. Never commit real secrets (NFR-GPU-047).

# --- Server (API and Worker) ---------------------------------------------------------------
# Application role: must NOT be a superuser and must NOT have BYPASSRLS.
STEWARD_DATABASE_URL=postgresql+psycopg://prayog_app:change-me@localhost:5432/prayog
# Optional: role WITH BYPASSRLS, used only for the retention purge and health aggregates.
STEWARD_MAINTENANCE_DATABASE_URL=
STEWARD_RUNTIME_URL=http://localhost:8100
STEWARD_PUBLIC_BASE_URL=http://localhost:8000
STEWARD_COOKIE_SECURE=                # true behind a TLS-terminating proxy
STEWARD_PORTS=prayog.integration.steward:steward_ports
STEWARD_EMBEDDER=hashing              # or st:BAAI/bge-small-en-v1.5 with the [rag] extra
STEWARD_SEARCH_PROVIDER=none          # none | tavily | brave
STEWARD_SEARCH_API_KEY=

# Spec parameters (§16.2, §16.4), defaults shown; ISO-8601 durations.
STEWARD_CORRELATION_WINDOW=PT24H
STEWARD_MIN_DISTINCT_USERS_FOR_WARNING=2
STEWARD_WARNING_COOLDOWN=PT24H
STEWARD_MAX_EVIDENCE_BUNDLE_ROWS=50
STEWARD_STEWARD_LINK_TTL=PT15M
STEWARD_RAG_RETENTION_PERIOD=P90D

# --- Migrations ----------------------------------------------------------------------------
# Run `alembic upgrade head` with STEWARD_DATABASE_URL set to the schema owner and:
STEWARD_APP_ROLE=prayog_app

# --- Runtime (separate process, no database access) ----------------------------------------
STEWARD_REASONING=claude              # claude | heuristic | stub
STEWARD_MODEL=claude-opus-5-5
STEWARD_EFFORT=medium
ANTHROPIC_API_KEY=
